# Copy this file to .env.local and fill in your keys.
# All variables are optional — omitted keys fall back to the Settings UI.

# ── LLM Provider ───────────────────────────────────────────────
# Which provider to activate by default: openrouter | openai | opencode
VITE_ACTIVE_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys)
VITE_OPENROUTER_KEY=sk-or-...

# OpenAI or any OpenAI-compatible endpoint
VITE_OPENAI_KEY=sk-...
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# OpenCode Go (set your real base URL; the placeholder below is not a live host)
VITE_OPENCODE_KEY=
VITE_OPENCODE_BASE_URL=

# ── Models ─────────────────────────────────────────────────────
# FAST = intent analyzer + dashboard planner. SMART = card code generator.
VITE_MODEL_FAST=google/gemini-2.5-flash
VITE_MODEL_SMART=deepseek/deepseek-chat

# ── Web Search (https://tavily.com) ────────────────────────────
VITE_TAVILY_KEY=tvly-...
